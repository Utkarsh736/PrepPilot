# Prep Pilot backend — copy to .env and fill in at least one key for full AI mode.
# Without keys the app runs in Demo Mode (template coaching + heuristic scoring).

# Default provider: gemini | groq | openrouter | demo
MODEL_PROVIDER=gemini

# Google Gemini (recommended free tier; also used for embeddings)
GOOGLE_API_KEY=

# Groq (very fast free inference)
GROQ_API_KEY=

# OpenRouter (many free models — use models ending in :free)
OPENROUTER_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
