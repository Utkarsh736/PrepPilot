# Prep Pilot backend — copy to .env and fill in at least one key for full AI mode.
# Without keys the app runs in Demo Mode (template coaching + heuristic scoring).

# Default provider: gemini | groq | openrouter | demo
MODEL_PROVIDER=gemini

# Google Gemini (recommended free tier; also used for embeddings when available)
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq free-tier models (as of 2026-10): openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (many free models — use models ending in :free)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional tuning
# TEMPERATURE=0.4
# RAG_TOP_K=6
# DATA_DIR=./data
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MAX_UPLOAD_BYTES=8388608
